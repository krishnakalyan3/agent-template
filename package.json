{
  "name": "agent-template",
  "version": "1.0.0",
  "description": "NVIDIA-themed hands-on agent template workshop with SQLite persistence",
  "main": "index.js",
  "scripts": {
    "dev": "concurrently -k \"npm:server\" \"npm:client\"",
    "server": "node --env-file-if-exists=.env server/index.js",
    "client": "vite",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env server/index.js",
    "test": "node --import tsx --test tests/*.test.*",
    "test:e2e": "playwright test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/krishnakalyan3/agent-template.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/krishnakalyan3/agent-template/issues"
  },
  "homepage": "https://github.com/krishnakalyan3/agent-template#readme",
  "private": true,
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.3",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "vite": "^8.3.1"
  },
  "dependencies": {
    "@fontsource/geist": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "express": "^5.2.1",
    "nodemailer": "^10.0.16",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
